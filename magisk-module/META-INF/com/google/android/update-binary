#!/sbin/sh
#################
# Initialization
#################
umask 022
ui_print() { echo "$1"; }
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk=true
if [ "$require_new_magisk" = true ]; then
  ui_print "Please install Magisk v20.4+ or KernelSU!"
  exit 1
fi
. /data/adb/magisk/util_functions.sh
install_module
exit 0
